{
  "hybrid": {
    "type": "object",
    "properties": {
      "triggered": {"type": "boolean"},
      "reason": {"type": "string"},
      "reasons": {"type": "array", "items": {"type": "string"}},
      "uploadPolicy": {"type": "string"},
      "cloudEnhanced": {"type": "boolean"},
      "mergeStrategy": {"type": "string"},
      "reconcileNote": {"type": "string"},
      "metrics": {
        "type": "object",
        "additionalProperties": {"type": "number"}
      },
      "delta": {
        "type": "object",
        "properties": {
          "countLocal": {"type": "integer"},
          "countCloud": {"type": "integer"},
          "countFinal": {"type": "integer"}
        }
      }
    },
    "required": ["triggered", "uploadPolicy", "cloudEnhanced"]
  },
  "evidence": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "timestampMs": {"type": "number"},
        "frameIndex": {"type": "integer"},
        "repIndex": {"type": "integer"},
        "phase": {"type": "string"},
        "cues": {"type": "array", "items": {"type": "string"}},
        "angles": {"type": "object", "additionalProperties": {"type": "number"}},
        "thresholds": {"type": "object", "additionalProperties": {"type": "number"}},
        "snapshotRef": {"type": "string"}
      },
      "required": ["type", "timestampMs"]
    }
  }
}
