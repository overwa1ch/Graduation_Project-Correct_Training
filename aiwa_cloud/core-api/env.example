# =============================================================================
# AIWA Auth API - Environment Variables (阿里云版本)
# =============================================================================
# 复制此文件为 .env 并填写实际值

# -----------------------------------------------------------------------------
# Database (本地开发或阿里云 RDS PostgreSQL)
# -----------------------------------------------------------------------------
# 本地开发（使用 docker-compose）
DATABASE_URL=postgresql://aiwa:aiwa_dev_password@localhost:5432/aiwa_auth

# 阿里云 RDS PostgreSQL（生产环境）
# 格式: postgresql://用户名:密码@内网地址:5432/数据库名
# 示例: DATABASE_URL=postgresql://aiwa_admin:your_password@rm-xxxxxxxxx.pg.rds.aliyuncs.com:5432/aiwa_cloud

# -----------------------------------------------------------------------------
# JWT Secrets
# -----------------------------------------------------------------------------
# ⚠️ 生产环境必须更改！
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production

# JWT 过期时间（可选，有默认值）
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# 开发环境: * (允许所有来源)
# 生产环境: 设置为你的 Flutter 应用域名
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m

# =============================================================================
# 阿里云配置（可选 - 用于后续扩展文件存储功能）
# =============================================================================
# 如果只需要登录功能，设置 USE_ALIYUN_OSS=false 或不设置

# 是否启用阿里云 OSS（默认关闭，后续扩展时开启）
USE_ALIYUN_OSS=false

# 阿里云区域（如：oss-cn-hangzhou, oss-cn-beijing, oss-cn-shanghai）
# ALIYUN_REGION=oss-cn-hangzhou

# 阿里云 AccessKey（从 RAM 控制台获取）
# ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
# ALIYUN_SECRET_ACCESS_KEY=your_aliyun_secret_access_key

# OSS Bucket 名称（用于存储用户文件，如头像等）
# ALIYUN_OSS_BUCKET=aiwa-cloud-storage-dev

# OSS 预签名URL过期时间（秒，默认900秒=15分钟）
# ALIYUN_OSS_PRESIGNED_EXPIRATION=900

# =============================================================================
# 部署说明
# =============================================================================
# 
# 最小配置（仅登录功能）：
# - DATABASE_URL（PostgreSQL 连接字符串）
# - JWT_ACCESS_SECRET（随机生成）
# - JWT_REFRESH_SECRET（随机生成）
# - NODE_ENV=production
# 
# 扩展配置（需要文件存储）：
# - USE_ALIYUN_OSS=true
# - ALIYUN_REGION
# - ALIYUN_ACCESS_KEY_ID
# - ALIYUN_SECRET_ACCESS_KEY
# - ALIYUN_OSS_BUCKET
# 
# 阿里云资源：
# 1. RDS PostgreSQL（必须）：用于存储用户数据
#    - 最低配置：1核2GB，约150元/月
#    - 创建方法：控制台 → 云数据库 RDS → PostgreSQL
# 
# 2. OSS 对象存储（可选）：用于存储用户文件
#    - 按存储量计费：约0.12元/GB/月
#    - 创建方法：控制台 → 对象存储 OSS
# 
# 3. ECS 云服务器（部署方案）：运行 API 服务
#    - 最低配置：2核2GB，约50元/月（按量付费）
#    - 创建方法：控制台 → 云服务器 ECS
# 
# =============================================================================
