# =============================================================================
# AIWA Auth API - Environment Variables (PostgreSQL 版本)
# =============================================================================
# 复制此文件为 .env 并填写实际值
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# 本地开发（使用 docker-compose）
DATABASE_URL=postgresql://aiwa:aiwa_dev_password@localhost:5432/aiwa_auth

# 阿里云 RDS PostgreSQL（生产环境）
# 格式: postgresql://用户名:密码@内网地址:5432/数据库名
# 示例: DATABASE_URL=postgresql://aiwa_admin:your_password@rm-xxxxxxxxx.pg.rds.aliyuncs.com:5432/aiwa_cloud

# -----------------------------------------------------------------------------
# JWT Secrets (必须更改！)
# -----------------------------------------------------------------------------
# ⚠️ 生产环境必须更改！
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production

# JWT 过期时间（可选，有默认值）
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# 开发环境: * (允许所有来源)
# 生产环境: 设置为你的 Flutter 应用域名
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Admin API (后台管理 my-app 调用)
# -----------------------------------------------------------------------------
# 用于 my-app 服务端调用 admin 接口时的鉴权，至少 32 字符
# 需与 my-app 的 .env.local 中 ADMIN_API_KEY 一致
# 开发环境可使用: dev_admin_key_32_chars_minimum_here
ADMIN_API_KEY=dev_admin_key_32_chars_minimum_here

# -----------------------------------------------------------------------------
# Rate Limiting (可选)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m

# =============================================================================
# 阿里云 OSS 配置（可选 - 当前版本未实现）
# =============================================================================
# 当前版本（v3.0）仅提供认证功能，不需要文件存储。
# 未来扩展时启用：设置 USE_ALIYUN_OSS=true 并配置以下变量

USE_ALIYUN_OSS=false
# ALIYUN_REGION=oss-cn-hangzhou
# ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
# ALIYUN_SECRET_ACCESS_KEY=your_aliyun_secret_access_key
# ALIYUN_OSS_BUCKET=aiwa-cloud-storage-dev
# ALIYUN_OSS_PRESIGNED_EXPIRATION=900
