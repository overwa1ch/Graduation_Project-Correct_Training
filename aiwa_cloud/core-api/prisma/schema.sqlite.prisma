// =============================================================================
// AIWA Auth API - Prisma Schema (SQLite 版本)
// =============================================================================
// 版本: 3.0 - SQLite 本地开发版
// 
// 说明：使用 SQLite 文件数据库，无需 Docker 或 PostgreSQL 服务器
// 适合：本地开发、快速测试、毕业设计演示
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 核心表（已实现）
// =============================================================================

// 用户表
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?   // 用户名（可选）
  avatar       String?   // 头像URL（可选，可存储在阿里云OSS）
  status       String    @default("active") // active | inactive | suspended
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  refreshTokens RefreshToken[]
  
  @@map("users")
}

// 刷新Token表
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =============================================================================
// SQLite 说明
// =============================================================================
// 
// SQLite 是文件数据库，不需要服务器，适合：
// - 本地开发和测试
// - 快速原型开发
// - 小型项目演示
// 
// 限制：
// - 并发写入性能较低（但单个用户/测试足够）
// - 不支持某些 PostgreSQL 特性（但本项目不使用）
// 
// 迁移到 PostgreSQL（生产环境）：
// 1. 修改 DATABASE_URL 为 PostgreSQL 连接字符串
// 2. 修改 datasource provider 为 "postgresql"
// 3. 运行 prisma migrate dev
// 
// =============================================================================

