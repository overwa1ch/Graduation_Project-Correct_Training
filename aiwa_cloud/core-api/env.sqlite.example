# =============================================================================
# AIWA Auth API - Environment Variables (SQLite 版本)
# =============================================================================
# 复制此文件为 .env 并填写实际值
# 
# 说明：SQLite 版本不需要 Docker 或 PostgreSQL 服务器
#       适合本地开发、快速测试、毕业设计演示
# =============================================================================

# -----------------------------------------------------------------------------
# Database (SQLite - 文件数据库，无需服务器)
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# 生产环境使用 PostgreSQL（需要时修改为）：
# DATABASE_URL=postgresql://aiwa_admin:密码@rm-xxx.pg.rds.aliyuncs.com:5432/aiwa_cloud

# -----------------------------------------------------------------------------
# JWT Secrets (必须更改！)
# -----------------------------------------------------------------------------
# ⚠️ 必须更改！不要使用默认值
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here_change_me_32chars_minimum
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me_32chars_minimum

# JWT 过期时间（可选，有默认值）
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# 注意：Windows 系统 3000-3012 端口被保留，推荐使用 8080

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# 开发环境: * (允许所有来源)
# 生产环境: 设置为你的 Flutter 应用域名
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Admin API (后台管理 my-app 调用)
# -----------------------------------------------------------------------------
# 用于 my-app 服务端调用 admin 接口时的鉴权，至少 32 字符
# 需与 my-app 的 .env.local 中 ADMIN_API_KEY 一致
ADMIN_API_KEY=dev_admin_key_32_chars_minimum_here

# -----------------------------------------------------------------------------
# Rate Limiting (可选)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m

# =============================================================================
# 阿里云 OSS 配置（可选 - 当前版本未实现）
# =============================================================================
# 当前版本（v3.0）仅提供认证功能，不需要文件存储。
# 未来扩展时启用：设置 USE_ALIYUN_OSS=true 并配置以下变量

USE_ALIYUN_OSS=false
# ALIYUN_REGION=oss-cn-hangzhou
# ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
# ALIYUN_SECRET_ACCESS_KEY=your_aliyun_secret_access_key
# ALIYUN_OSS_BUCKET=aiwa-cloud-storage-dev
# ALIYUN_OSS_PRESIGNED_EXPIRATION=900
