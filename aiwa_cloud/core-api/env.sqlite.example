# =============================================================================
# AIWA Auth API - Environment Variables (SQLite 版本)
# =============================================================================
# 复制此文件为 .env 并填写实际值
# 
# 说明：SQLite 版本不需要 Docker 或 PostgreSQL 服务器
#       适合本地开发、快速测试、毕业设计演示
# =============================================================================

# -----------------------------------------------------------------------------
# Database (SQLite - 文件数据库，无需服务器)
# -----------------------------------------------------------------------------
# 使用 SQLite 文件数据库（开发环境推荐）
DATABASE_URL="file:./dev.db"

# 或者使用完整路径：
# DATABASE_URL="file:/absolute/path/to/dev.db"

# 生产环境使用 PostgreSQL（需要时修改为）：
# DATABASE_URL=postgresql://aiwa_admin:密码@rm-xxx.pg.rds.aliyuncs.com:5432/aiwa_cloud

# -----------------------------------------------------------------------------
# JWT Secrets
# -----------------------------------------------------------------------------
# ⚠️ 必须更改！不要使用默认值
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here_change_me_32chars_minimum
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me_32chars_minimum

# JWT 过期时间（可选，有默认值）
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# 注意：
# - Windows 系统：3000-3012 端口被系统保留，请使用 8080 或其他端口
# - 如果 8080 被占用，可以尝试 8081, 4000, 5000 等

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# 开发环境: * (允许所有来源)
# 生产环境: 设置为你的 Flutter 应用域名
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m

# =============================================================================
# 阿里云配置（可选 - 用于后续扩展文件存储功能）
# =============================================================================
# 如果只需要登录功能，设置 USE_ALIYUN_OSS=false 或不设置

# 是否启用阿里云 OSS（默认关闭，后续扩展时开启）
USE_ALIYUN_OSS=false

# 阿里云区域（如：oss-cn-hangzhou, oss-cn-beijing, oss-cn-shanghai）
# ALIYUN_REGION=oss-cn-hangzhou

# 阿里云 AccessKey（从 RAM 控制台获取）
# ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
# ALIYUN_SECRET_ACCESS_KEY=your_aliyun_secret_access_key

# OSS Bucket 名称（用于存储用户文件，如头像等）
# ALIYUN_OSS_BUCKET=aiwa-cloud-storage-dev

# OSS 预签名URL过期时间（秒，默认900秒=15分钟）
# ALIYUN_OSS_PRESIGNED_EXPIRES_IN=900

# =============================================================================
# SQLite 版本说明
# =============================================================================
# 
# 优点：
# - ✅ 无需 Docker 或数据库服务器
# - ✅ 设置简单，一个文件即可
# - ✅ 适合本地开发和测试
# - ✅ 适合毕业设计演示
# 
# 缺点：
# - ❌ 不适合高并发生产环境
# - ❌ 不支持多服务器部署
# 
# 迁移建议：
# - 开发环境：使用 SQLite（当前配置）
# - 生产环境：使用 PostgreSQL（修改 DATABASE_URL）
# 
# =============================================================================

