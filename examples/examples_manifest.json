{
  "version": "C-milestone-manifest",
  "samples": [
    {
      "sampleId": "squat_normal",
      "category": "正常样本",
      "purpose": "验证主流程、输出格式与证据生成",
      "inputs": [
        "squat_normal/neutral_keypoints.json"
      ],
      "expectedOutputs": [
        "squat_normal/expected/result.json",
        "squat_normal/expected/angles.csv",
        "squat_normal/expected/evidence.json",
        "squat_normal/expected/perf.json"
      ],
      "validationRules": [
        "hybrid.triggered == false",
        "scores.overall >= 88",
        "perf.pipelineRtf < 0.9"
      ]
    },
    {
      "sampleId": "squat_occlusion",
      "category": "异常样本",
      "purpose": "验证 Hybrid 触发与云端合并逻辑",
      "inputs": [
        "squat_occlusion/input.mp4",
        "squat_occlusion/hybrid_policy.json",
        "squat_occlusion/cloud_result.json"
      ],
      "expectedOutputs": [
        "squat_occlusion/expected/result.json",
        "squat_occlusion/expected/angles.csv",
        "squat_occlusion/expected/evidence.json",
        "squat_occlusion/expected/perf.json"
      ],
      "validationRules": [
        "hybrid.triggered == true",
        "hybrid.mergeStrategy == 'prefer-cloud-count-then-reconcile'",
        "issues.exists(code == 'occlusion-left-leg')"
      ]
    },
    {
      "sampleId": "squat_short",
      "category": "性能样本",
      "purpose": "验证超短素材下的启动开销与降级逻辑",
      "inputs": [
        "squat_short/input.mp4"
      ],
      "expectedOutputs": [
        "squat_short/expected/result.json",
        "squat_short/expected/angles.csv",
        "squat_short/expected/evidence.json",
        "squat_short/expected/perf.json"
      ],
      "validationRules": [
        "repCount == 2",
        "quality.coverage >= 0.85",
        "perf.pipelineRtf <= 0.6"
      ]
    },
    {
      "sampleId": "squat_long",
      "category": "性能样本",
      "purpose": "验证超长素材下的耗时、内存与批次策略",
      "inputs": [
        "squat_long/input.mp4"
      ],
      "expectedOutputs": [
        "squat_long/expected/result.json",
        "squat_long/expected/angles.csv",
        "squat_long/expected/evidence.json",
        "squat_long/expected/perf.json"
      ],
      "validationRules": [
        "repCount == 168",
        "perf.pipelineRtf <= 1.0",
        "perf.memPeakMB <= 540"
      ]
    },
    {
      "sampleId": "squat_tempo_irregular",
      "category": "节奏样本",
      "purpose": "验证节奏忽快忽慢时的稳定性",
      "inputs": [
        "squat_tempo_irregular/input.mp4"
      ],
      "expectedOutputs": [
        "squat_tempo_irregular/expected/result.json",
        "squat_tempo_irregular/expected/angles.csv",
        "squat_tempo_irregular/expected/evidence.json",
        "squat_tempo_irregular/expected/perf.json"
      ],
      "validationRules": [
        "scores.tempo <= 80",
        "issues.exists(code == 'tempo-inconsistent')",
        "perf.pipelineRtf < 0.85"
      ]
    },
    {
      "sampleId": "squat_noisy_keypoints",
      "category": "噪声样本",
      "purpose": "验证噪声关键点下的鲁棒性",
      "inputs": [
        "squat_noisy_keypoints/neutral_keypoints.json"
      ],
      "expectedOutputs": [
        "squat_noisy_keypoints/expected/result.json",
        "squat_noisy_keypoints/expected/angles.csv",
        "squat_noisy_keypoints/expected/evidence.json",
        "squat_noisy_keypoints/expected/perf.json"
      ],
      "validationRules": [
        "quality.lowConfidence >= 0.15",
        "repCount == 6",
        "perf.memPeakMB < 420"
      ]
    }
  ]
}
