{
  "version": "C-augment",
  "engine": "any",
  "uploadPolicy": "keypoints_only",
  "rules": [
    {
      "name": "low_coverage",
      "metric": "coverage",
      "op": "<",
      "threshold": 0.85,
      "weight": 1.0
    },
    {
      "name": "low_conf_pct",
      "metric": "lowConfPct",
      "op": ">",
      "threshold": 0.15,
      "weight": 1.0
    },
    {
      "name": "fps_instability",
      "metric": "jitterPx",
      "op": ">",
      "threshold": 5.0,
      "weight": 0.5
    }
  ],
  "trigger": {
    "mode": "weighted_sum",
    "weighted_sum_threshold": 1.0
  },
  "sliceMsBefore": 1500,
  "sliceMsAfter": 1500
}
